{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexus",
  "version": "1.0.1",
  "identifier": "app.nexus.vrchat",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nexus",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600,
        "visible": false,
        "decorations": true,
        "backgroundColor": "#0b0c10"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "LunoviaVR",
    "copyright": "© 2026 LunoviaVR",
    "homepage": "https://github.com/LunoviaVR/Nexus",
    "category": "SocialNetworking",
    "shortDescription": "A modern VRChat companion app",
    "longDescription": "Nexus keeps track of your VRChat friends, the worlds you visit and the people you meet, with live updates, a searchable feed, a game log and insights. Your history stays on your PC, encrypted."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYwRTEyNUQ4RTVGOTZFOUUKUldTZWJ2bmwyQ1hoWUdqYWhqQ2pVWE91YkNrazVWWEdTU2dmSDhBWXJDY3dra1YwR2Z6ZWJuMlQK",
      "endpoints": [
        "https://github.com/LunoviaVR/Nexus/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
